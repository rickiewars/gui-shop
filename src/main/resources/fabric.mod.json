{
	"schemaVersion": 1,
	"id": "gui-shop",
	"version": "${version}",
	"name": "GUI Shop",
	"description": "A server side mod for admin GUI shops via command",
	"authors": [
		"Rickiewars",
		"UnsafeDodo"
	],
	"contact": {
		"homepage": "https://github.com/rickiewars/gui-shop",
		"sources": "https://github.com/rickiewars/gui-shop"
	},
